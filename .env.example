# ── Neon Postgres ─────────────────────────────────────────────
# Pooled connection (app queries + Prisma db push). Neon dashboard →
# Connection Details, keep "Pooled connection" ON. Ends with -pooler...neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Neon Auth (@neondatabase/auth — Better Auth) ──────────────
# Base URL: Neon dashboard → Auth → Configuration. It's your project host
# with `neonauth` + `/neondb/auth`, e.g. https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth"
# Secret used to sign auth cookies. Must be >= 32 chars.
# Generate one:  openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# Comma-separated emails allowed into /admin (authorization on top of auth).
ADMIN_EMAILS=""

# ── Contact form email (Resend) ───────────────────────────────
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=""
# Where contact messages are delivered.
CONTACT_TO_EMAIL=""
# Sender. Leave as onboarding@resend.dev to start (delivers to your Resend
# account email); once amahkudi.dev is verified, use e.g. "Henson <hello@amahkudi.dev>".
CONTACT_FROM_EMAIL=""

# ── Inbound email forwarding (Resend webhook) ─────────────────
# Resend → Webhooks: add the `email.received` event pointing at
#
# Then paste the signing secret here (starts with whsec_).
RESEND_WEBHOOK_SECRET=""
# Where received emails get forwarded.
INBOUND_FORWARD_TO=""
# From address for the forward — must be a verified sender on domain.
INBOUND_FORWARD_FROM=""
