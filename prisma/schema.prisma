// Prisma schema — Henson portfolio CMS
// DB: Neon Postgres. DATABASE_URL = pooled connection. Workflow: `prisma db push`.
// Data model mirrors the design's store.js so the admin + public pages line up.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Selected work / projects. Rich enough to drive both the cards and the
/// case-study detail page (overview → problem → contribution → challenges → outcomes).
model Project {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  badge        String? // short chip, e.g. "Founder", "Team Lead"
  role         String? // e.g. "Founder & Lead Engineer"
  org          String? // company / org
  summary      String // card + section blurb
  // case-study body (all optional; shown on the detail page when present)
  overview     String?
  problem      String?
  contribution String?
  challenges   String?
  outcomes     String?
  coverImage   String?
  stack        String[] @default([])
  liveUrl      String?
  repoUrl      String?
  caseStudyUrl String?
  confidential Boolean  @default(false)
  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, featured, order])
}

/// Blog / writing entries. `body` holds rich-text HTML from the admin editor.
/// The SEO / publishing-pack fields (keywords, category, internal links,
/// sources, share text) feed the public page's meta tags and JSON-LD.
model Post {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String?
  body           String    @default("") // HTML
  coverImage     String?
  coverAlt       String? // alt text for the cover (accessibility + image SEO)
  tags           String[]  @default([])
  featured       Boolean   @default(false)
  published      Boolean   @default(false)
  publishedAt    DateTime? // the display date
  readingMinutes Int? // auto-computed from the body on save
  wordCount      Int? // auto-computed from the body on save
  order          Int       @default(0)
  // SEO
  seoTitle       String?
  seoDescription String? // meta description (aim for ≤160 chars)
  primaryKeyword String? // the one phrase the post targets
  keywords       String[]  @default([]) // secondary keywords → meta keywords + JSON-LD
  canonicalUrl   String? // set only when the post was first published elsewhere
  // Editorial taxonomy
  category       String? // cluster, e.g. "Money-moving systems"
  postType       String? // "Explainer", "Story", "Guide" …
  // Internal links (slugs of other posts). Rendered only when the target is published.
  hubSlug        String? // the hub / pillar post this one sits under
  relatedSlugs   String[]  @default([]) // across / down links
  // Sources cited: [{ label, url }]
  sources        Json      @default("[]")
  // Social share blurb (LinkedIn etc.) — stored for copy/paste, never rendered publicly.
  shareText      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([published, featured, order])
}

/// Work experience — drives the homepage timeline AND the generated CV.
/// endDate null = "Present". Sorted by startDate desc.
model Experience {
  id         String    @id @default(cuid())
  role       String
  company    String // may include product, e.g. "ITSEC · Nexus Crypto Exchange"
  location   String?
  startDate  DateTime
  endDate    DateTime? // null = Present
  summary    String    @default("") // paragraph shown on the homepage
  highlights String[]  @default([]) // bullet points for the CV
  published  Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([published, startDate])
}

/// Client / teammate references.
model Testimonial {
  id            String   @id @default(cuid())
  quote         String
  authorName    String
  authorRole    String?
  authorCompany String?
  avatarUrl     String?
  published     Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Singleton row holding editable homepage SEO / metadata.
model SeoSettings {
  id              String   @id @default("homepage")
  metaTitle       String
  metaDescription String
  keywords        String[] @default([])
  author          String?
  ogImage         String?
  canonicalUrl    String?
  twitterHandle   String?
  updatedAt       DateTime @updatedAt
}
